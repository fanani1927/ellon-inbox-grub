{
  "name": "ellon-inbox-grub",
  "version": "1.0.2",
  "description": "Dashboard Automasi Ellon",
  "author": "ELLONCORP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rimraf dist",
    "build": "npm run clean && electron-builder --win",
    "publish": "npm run clean && electron-builder --win -p always"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "selenium-webdriver": "^4.18.1",
    "tree-kill": "^1.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.ellon.inboxgrub",
    "productName": "Ellon Inbox Grub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/selenium-webdriver/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fanani1927",
        "repo": "ellon-inbox-grub"
      }
    ]
  }
}
